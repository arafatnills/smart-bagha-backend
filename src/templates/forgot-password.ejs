<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="color-scheme" content="light" />
  <meta name="supported-color-schemes" content="light" />
  <title>Reset Your Password | Smart Bagha</title>
</head>

<body style="margin:0; padding:0; background-color:#f4f6f9; font-family:Arial, Helvetica, sans-serif; color:#202938;">

  <!-- Preheader -->
  <div style="display:none; max-height:0; overflow:hidden; opacity:0; color:transparent; mso-hide:all;">
    Hi <%= name %>, your Smart Bagha password reset code is ready. It expires in 5 minutes.
  </div>

  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0"
    style="width:100%; background-color:#f4f6f9;">
    <tr>
      <td align="center" style="padding:35px 12px;">

        <!-- Main Card -->
        <table role="presentation" width="600" cellspacing="0" cellpadding="0" border="0"
          style="width:100%; max-width:600px; background-color:#ffffff; border-radius:16px; overflow:hidden;">

          <!-- Smart Bagha Brand Header -->
          <tr>
            <td align="center" style="padding:30px 24px 26px; background-color:#ffffff;">
              <table role="presentation" cellspacing="0" cellpadding="0" border="0">
                <tr>
                  <td valign="middle" style="padding-right:10px;">
                    <div style="width:42px; height:42px; line-height:42px; text-align:center; border-radius:12px; background-color:#dc2626; color:#ffffff; font-size:25px; font-weight:bold;">
                      +
                    </div>
                  </td>
                  <td valign="middle">
                    <div style="font-size:25px; line-height:1.2; font-weight:800; letter-spacing:-0.7px; color:#111827;">
                      Smart <span style="color:#dc2626;">Bagha</span>
                    </div>
                    <div style="font-size:11px; letter-spacing:1.5px; color:#6b7280; margin-top:4px;">
                      DONATE BLOOD. SAVE LIVES.
                    </div>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Red Password Reset Banner -->
          <tr>
            <td align="center" style="padding:38px 24px 34px; background-color:#dc2626; background-image:linear-gradient(135deg,#b91c1c,#ef4444);">
              <div style="width:66px; height:66px; line-height:66px; margin:0 auto 20px; border-radius:50%; background-color:#ffffff; color:#dc2626; font-size:30px; font-weight:bold;">
                &#128274;
              </div>

              <h1 style="margin:0; font-size:29px; line-height:1.3; font-weight:800; color:#ffffff;">
                Reset Your Password
              </h1>

              <p style="margin:12px 0 0; font-size:15px; line-height:1.8; color:#fff1f2;">
                Secure your account and get back to Smart Bagha.
              </p>
            </td>
          </tr>

          <!-- Greeting and Instructions -->
          <tr>
            <td style="padding:34px 30px 10px;">
              <p style="margin:0 0 16px; font-size:17px; line-height:1.7; color:#374151;">
                Hi <strong style="color:#dc2626;"><%= name %></strong>,
              </p>

              <p style="margin:0 0 16px; font-size:15px; line-height:1.9; color:#4b5563;">
                We received a request to reset the password for your
                <strong style="color:#111827;">Smart Bagha</strong> account.
                Use the verification code below to continue.
              </p>

              <p style="margin:0; font-size:15px; line-height:1.8; color:#4b5563;">
                Enter this code on the password reset page to verify your identity.
              </p>
            </td>
          </tr>

          <!-- OTP Code Box -->
          <tr>
            <td style="padding:26px 24px 22px;">
              <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0"
                style="width:100%; background-color:#fff5f5; border:1px solid #fee2e2; border-radius:14px;">
                <tr>
                  <td align="center" style="padding:26px 12px 24px;">
                    <p style="margin:0 0 16px; font-size:12px; line-height:1.5; font-weight:700; letter-spacing:1.8px; color:#991b1b;">
                      YOUR VERIFICATION CODE
                    </p>

                    <table role="presentation" cellspacing="0" cellpadding="0" border="0">
                      <tr>
                        <td align="center" style="padding:14px 18px; background-color:#ffffff; border:1px dashed #dc2626; border-radius:10px;">
                          <span style="font-family:Arial, Helvetica, sans-serif; font-size:32px; line-height:1.4; font-weight:800; letter-spacing:8px; color:#dc2626; white-space:nowrap;">
                            <%= otp %>
                          </span>
                        </td>
                      </tr>
                    </table>

                    <p style="margin:18px 0 0; font-size:13px; line-height:1.7; color:#6b2930;">
                      This code is valid for <strong>5 minutes</strong> only.
                    </p>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Security Notice -->
          <tr>
            <td style="padding:0 30px 28px;">
              <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0"
                style="width:100%; background-color:#fffbeb; border:1px solid #fde68a; border-radius:10px;">
                <tr>
                  <td valign="top" style="width:28px; padding:16px 0 16px 15px;">
                    <span style="font-size:18px;">&#9888;</span>
                  </td>
                  <td style="padding:15px 15px 15px 8px;">
                    <p style="margin:0 0 6px; font-size:14px; line-height:1.5; font-weight:700; color:#92400e;">
                      Keep your account safe
                    </p>

                    <p style="margin:0; font-size:13px; line-height:1.8; color:#78350f;">
                      Never share this verification code with anyone. Smart Bagha will never ask you to disclose your OTP over a call or message.
                    </p>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Didn't Request Password Reset -->
          <tr>
            <td style="padding:0 30px 32px;">
              <p style="margin:0 0 10px; font-size:14px; line-height:1.8; color:#374151;">
                <strong>Didn't request a password reset?</strong>
              </p>

              <p style="margin:0; font-size:14px; line-height:1.8; color:#6b7280;">
                You can safely ignore this email. Your password will remain unchanged unless you complete the reset process.
              </p>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td align="center" style="padding:26px 24px; background-color:#f9fafb; border-top:1px solid #f0f1f3;">
              <p style="margin:0 0 8px; font-size:15px; font-weight:700; color:#374151;">
                Stay safe. Keep making a difference.
              </p>

              <p style="margin:0 0 18px; font-size:13px; line-height:1.7; color:#6b7280;">
                Thank you for being part of the Smart Bagha community.
              </p>

              <p style="margin:0; font-size:12px; color:#9ca3af;">
                &copy; <%= year %> Smart Bagha. All rights reserved.
              </p>

              <p style="margin:8px 0 0; font-size:12px; line-height:1.7; color:#9ca3af;">
                This email was sent because a password reset was requested for your account.
              </p>
            </td>
          </tr>

        </table>

        <!-- Bottom Caption -->
        <p style="margin:20px 12px 0; font-size:11px; line-height:1.7; color:#9ca3af; text-align:center;">
          Smart Bagha &middot; Connecting donors, supporting lives.
        </p>

      </td>
    </tr>
  </table>
</body>
</html>